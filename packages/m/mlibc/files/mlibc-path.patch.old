diff --git a/meson.build b/meson.build
index 27d78ab1..eed4c08a 100644
--- a/meson.build
+++ b/meson.build
@@ -367,7 +367,7 @@ configure_file(input: 'mlibc-config.h.in',
 	output: 'mlibc-config.h',
 	configuration: mlibc_conf,
 	install: not no_headers,
-	install_dir: get_option('includedir'))
+	install_dir: get_option('includedir') + '/mlibc')
 
 internal_sources = [
 	'options/internal/generic/allocator.cpp',
@@ -401,7 +401,8 @@ endif
 
 if not no_headers
 	install_headers(
-		'options/internal/include/stdint.h'
+		'options/internal/include/stdint.h',
+		subdir: 'mlibc'
 	)
 
 	if host_machine.cpu_family() == 'riscv64'
@@ -435,7 +436,7 @@ if not no_headers
 		'options/internal/include/bits/winsize.h',
 		'options/internal/include/bits/search.h',
 		'options/internal/include/bits/getopt.h',
-		subdir: 'bits'
+		subdir: 'mlibc/bits'
 	)
 endif
 
