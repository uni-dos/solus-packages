diff --git a/options/linux/meson.build b/options/linux/meson.build
index 4fff1f9c..967c2f31 100644
--- a/options/linux/meson.build
+++ b/options/linux/meson.build
@@ -44,6 +44,7 @@ if not no_headers
 		'include/values.h',
 		'include/lastlog.h',
 		'include/module.h',
+		subdir: 'mlibc'
 	)
 	install_headers(
 		'include/bits/linux/linux_unistd.h',
@@ -52,18 +53,18 @@ if not no_headers
 		'include/bits/linux/linux_uio.h',
 		'include/bits/linux/linux_utmp.h',
 		'include/bits/linux/cpu_set.h',
-		subdir: 'bits/linux'
+		subdir: 'mlibc/bits/linux'
 	)
 	install_headers(
 		'include/netpacket/packet.h',
-		subdir: 'netpacket'
+		subdir: 'mlibc/netpacket'
 	)
 	# libc provides these, not the kernel, so the Linux option shall provide them too.
 	install_headers(
 		'include/scsi/scsi.h',
 		'include/scsi/scsi_ioctl.h',
 		'include/scsi/sg.h',
-		subdir: 'scsi'
+		subdir: 'mlibc/scsi'
 	)
 	install_headers(
 		'include/sys/epoll.h',
@@ -88,7 +89,7 @@ if not no_headers
